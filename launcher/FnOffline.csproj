<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RadarniteLauncher</AssemblyName>
    <Product>Radarnite Launcher</Product>
    <AssemblyTitle>Radarnite Launcher</AssemblyTitle>
    <Description>Radarnite Launcher: old Fortnite builds offline, 127.0.0.1 only</Description>
    <Company>Radarnite</Company>
    <!-- Single source of truth for the version: the auto-updater reads it from the assembly, and tools\build-release.ps1
         passes it to makensis as -DVERSION. Bump this (and nothing else) for each release. -->
    <Version>2.2.0</Version>
    <ApplicationIcon>radarnite.ico</ApplicationIcon>
    <RootNamespace>FnOffline</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="ui" />
    <None Include="radarnite.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
