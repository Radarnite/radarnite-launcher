// Resources of the native UI. Fonts, logo and icon come from launcher/ (the 2.x page assets, unchanged).
#include "resource.h"

1 24 "app.manifest"
IDI_APP ICON "../../launcher/radarnite.ico"
RES_FONT_INTER RCDATA "../../launcher/ui/fonts/Inter-var-latin.woff2"
RES_FONT_INTER_TIGHT RCDATA "../../launcher/ui/fonts/InterTight-900i-latin.woff2"
RES_LOGO_PNG RCDATA "../../launcher/ui/radarnite.png"

// Version resource with 2.2.1's fields: FileVersion X.Y.Z.N, ProductVersion the full semver ("3.0.0-rc.1"), from
// native/core/version.h (the core's version.gen.h when it was built with RN_VERSION; see build.sh).
#include "../core/version.h"
1 VERSIONINFO
FILEVERSION RN_VERSION_MAJOR, RN_VERSION_MINOR, RN_VERSION_PATCH, RN_VERSION_BUILD
PRODUCTVERSION RN_VERSION_MAJOR, RN_VERSION_MINOR, RN_VERSION_PATCH, RN_VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS RN_VERSION_FLAGS
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Comments", "Radarnite Launcher: old Fortnite builds offline, 127.0.0.1 only"
            VALUE "CompanyName", "Radarnite"
            VALUE "FileDescription", "Radarnite Launcher"
            VALUE "FileVersion", RN_VERSION_FILE_STR
            VALUE "InternalName", "RadarniteLauncher.exe"
            VALUE "LegalCopyright", " "
            VALUE "OriginalFilename", "RadarniteLauncher.exe"
            VALUE "ProductName", "Radarnite Launcher"
            VALUE "ProductVersion", RN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
